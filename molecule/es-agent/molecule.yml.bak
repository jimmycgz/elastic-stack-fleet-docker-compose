---
dependency:
  name: galaxy
  options:
    requirements-file: requirements.yml
    ignore-certs: true
    ignore-errors: true

driver:
  name: docker

platforms:
  # Setup container for initial configuration
  - name: kibana
    image: docker.elastic.co/kibana/kibana:8.15.2
    pre_build_image: true
    hostname: kibana
    depends_on:
      elasticsearch:
        condition: service_healthy
    entrypoint: []
    working_dir: /usr/share/kibana
    command: >-
      bash -c '
        # Wait for certs and elasticsearch
        until [ -f /usr/share/kibana/config/certs/kibana/kibana.crt ] && \
              curl -s --cacert /usr/share/kibana/config/certs/ca/ca.crt https://elasticsearch:9200 | grep -q "missing authentication credentials"; do
          echo "Waiting for certificates and elasticsearch..."
          sleep 5
        done
        
        # Source the env file
        ENV_FILE="/usr/share/kibana/pre-stack/es-agent/.env"
        if [ -f "$ENV_FILE" ]; then
          echo "Sourcing environment file: $ENV_FILE"
          source "$ENV_FILE"
        else
          echo "Warning: Environment file not found at $ENV_FILE"
          # Set default values if env file is not found
          export ELASTIC_PASSWORD=${ELASTIC_PASSWORD:-elastic}
          export KIBANA_PASSWORD=${KIBANA_PASSWORD:-elastic}
          export KIBANA_ELASTICSEARCH_HOSTS=${KIBANA_ELASTICSEARCH_HOSTS:-https://elasticsearch:9200}
          export FLEET_HOST=${FLEET_HOST:-https://fleet-server:8220}
        fi

        echo "Creating Kibana configuration..."
        cat << '\''ENDOFFILE'\'' > /usr/share/kibana/config/kibana.yml
        server.host: "0.0.0.0"
        server.name: kibana
        server.ssl.enabled: true
        server.ssl.certificate: /usr/share/kibana/config/certs/kibana/kibana.crt
        server.ssl.key: /usr/share/kibana/config/certs/kibana/kibana.key
        elasticsearch.hosts: ["https://elasticsearch:9200"]
        elasticsearch.username: "kibana_system"
        elasticsearch.password: "${KIBANA_PASSWORD}"
        elasticsearch.ssl.certificateAuthorities: ["/usr/share/kibana/config/certs/ca/ca.crt"]
        elasticsearch.ssl.verificationMode: certificate
        xpack.encryptedSavedObjects.encryptionKey: "abc45678901234567890123456789012"
        xpack.fleet.enabled: true
        xpack.fleet.agents.enabled: true
        xpack.fleet.agents.fleet_server.hosts: ["${FLEET_HOST}"]
        xpack.actions.preconfiguredAlertHistoryESIndex: true
        xpack.security.encryptionKey: "${KIBANA_PASSWORD}"
        xpack.reporting.encryptionKey: "${KIBANA_PASSWORD}"
        ENDOFFILE

        # Replace environment variables in config
        envsubst < /usr/share/kibana/config/kibana.yml > /usr/share/kibana/config/kibana.yml.tmp
        mv /usr/share/kibana/config/kibana.yml.tmp /usr/share/kibana/config/kibana.yml

        echo "Starting Kibana..."
        exec /usr/local/bin/kibana-docker
      '
    volumes:
      - certs:/usr/share/kibana/config/certs:ro
      - /workspaces/elastic-stack-fleet-docker-compose/pre-stack/es-agent:/usr/share/kibana/pre-stack/es-agent:ro
    mem_limit: ${MEM_LIMIT:-512m}
    published_ports:
      - 0.0.0.0:5601:5601/tcp  
    networks:
      - name: elastic
    depends_on:
      - elasticsearch
    healthcheck:
      test: ["CMD-SHELL", "curl -s -I --cacert config/certs/ca/ca.crt https://kibana:5601 | grep -q 'HTTP/1.1 302 Found'"]
      interval: 10s
      timeout: 10s
      retries: 120

  # Fleet Server container
  - name: fleet-server
    image: docker.elastic.co/beats/elastic-agent:8.15.2
    pre_build_image: true
    hostname: fleet-server
    command: |
      bash -c '
        sleep infinity && 
        source /usr/share/elastic-agent/pre-stack/es-agent/.env &&
        echo "Starting Fleet Server on hostname: $FLEET_HOST" &&
        /usr/local/bin/docker-entrypoint.sh
      '
    volumes:
      - certs:/usr/share/elastic-agent/config/certs
      - /workspaces/elastic-stack-fleet-docker-compose/pre-stack/es-agent:/usr/share/elastic-agent/pre-stack/es-agent:ro
    # tmpfs:
      # - /usr/share/elastic-agent/config/certs:uid=0,gid=0
    mem_limit: ${MEM_LIMIT:-512m}
    ports:
      - "${FLEET_PORT:-8220}:8220"
    networks:
      - name: elastic
    depends_on:
      - elasticsearch
      - kibana

  # Test instance for es-agent deployment
  - name: instance
    image: geerlingguy/docker-ubuntu2004-ansible
    pre_build_image: true
    privileged: true
    packages:
      - python3
      - python3-pip
      - curl
      - ca-certificates
    command: |
      bash -c '
        apt update 
        apt install -y curl
        sleep infinity
      '
    volumes:
      - certs:/usr/share/elasticsearch/config/certs
      - /workspaces/elastic-stack-fleet-docker-compose/pre-stack/es-agent:/usr/share/elasticsearch/pre-stack:ro
    networks:
      - name: elastic
    groups:
      - elastic_agents
    depends_on:
      - elasticsearch
      - kibana
      - fleet-server

provisioner:
  name: ansible
  env:
    ANSIBLE_ROLES_PATH: ../../roles
  inventory:
    group_vars:
      all:
        elastic_password: "{{ lookup('env', 'ELASTIC_PASSWORD') }}"
        kibana_password: "{{ lookup('env', 'KIBANA_PASSWORD') }}"
        fleet_host: "{{ lookup('env', 'FLEET_HOST') }}"
        es_host: "{{ lookup('env', 'ELASTICSEARCH_HOST') }}"
        kibana_host: "{{ lookup('env', 'KIBANA_FLEET_HOST') }}"
        ca_cert: "{{ lookup('env', 'CA_CERT') }}"

verifier:
  name: ansible

scenario:
  test_sequence:
    - dependency
    # - cleanup
    - destroy
    - create
    - prepare
    - converge
