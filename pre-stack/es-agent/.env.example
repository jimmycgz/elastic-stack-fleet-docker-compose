# Elasticsearch Configuration
ELASTIC_PASSWORD=elastic
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_HOST=https://elasticsearch:9200
ES_PORT=9200
ES_URL=https://localhost:9200
ES_JAVA_OPTS="-Xms512m -Xmx512m"
ES_EX_VAR=test-var
ES_TEST_VAR=test-value

# Node Configuration
NODE_NAME=elasticsearch
CLUSTER_NAME=docker-cluster
DISCOVERY_TYPE=single-node
MEM_LIMIT=1g

# Security Configuration
XPACK_SECURITY_ENABLED=true
XPACK_SECURITY_HTTP_SSL_ENABLED=true
XPACK_SECURITY_HTTP_SSL_KEY=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.key
XPACK_SECURITY_HTTP_SSL_CERTIFICATE=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.crt
XPACK_SECURITY_HTTP_SSL_CA=/usr/share/elasticsearch/config/certs/ca/ca.crt
XPACK_SECURITY_HTTP_SSL_VERIFICATION=certificate
XPACK_SECURITY_TRANSPORT_SSL_ENABLED=true
XPACK_SECURITY_TRANSPORT_SSL_KEY=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.key
XPACK_SECURITY_TRANSPORT_SSL_CERTIFICATE=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.crt
XPACK_SECURITY_TRANSPORT_SSL_CA=/usr/share/elasticsearch/config/certs/ca/ca.crt
XPACK_SECURITY_TRANSPORT_SSL_VERIFICATION=certificate
XPACK_LICENSE_TYPE=trial

# Kibana Configuration
KIBANA_PORT=5601
KIBANA_PASSWORD=elastic
KIBANA_FLEET_HOST=https://kibana:5601
KIBANA_SERVER_NAME=kibana
KIBANA_ELASTICSEARCH_HOSTS=https://elasticsearch:9200
KIBANA_SSL_ENABLED=true
KIBANA_SSL_CERTIFICATE=/usr/share/kibana/config/certs/kibana/kibana.crt
KIBANA_SSL_KEY=/usr/share/kibana/config/certs/kibana/kibana.key
KIBANA_SSL_CA=/usr/share/kibana/config/certs/ca/ca.crt
XPACK_ENCRYPTEDSAVEDOBJECTS_KEY=elastic123456789012345678901234567890
XPACK_ACTIONS_PRECONFIGURED=true

# Fleet Configuration
FLEET_PORT=8220
FLEET_HOST=https://fleet-server:8220
FLEET_URL=https://localhost:8220
FLEET_SERVER_ENABLE=1
FLEET_SERVER_HOST=0.0.0.0
FLEET_SERVER_PORT=8220
FLEET_SERVER_CERT=/usr/share/elastic-agent/config/certs/fleet-server/fleet-server.crt
FLEET_SERVER_CERT_KEY=/usr/share/elastic-agent/config/certs/fleet-server/fleet-server.key
FLEET_SERVER_POLICY_ID=fleet-server-policy
FLEET_SERVER_INSECURE_HTTP=true
XPACK_FLEET_ENABLED=true
XPACK_FLEET_AGENTS_ENABLED=true
XPACK_FLEET_AGENTS_FLEET_SERVER_HOSTS=["https://fleet-server:8220"]

# Stack Configuration
STACK_VERSION=8.15.2
LICENSE=trial
COMPOSE_PROJECT_NAME=elastic-stack

# Certificate Paths
CA_CERT=/usr/share/elastic-agent/config/certs/ca/ca.crt
